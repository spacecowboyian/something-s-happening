# Example: Workflow with Git Push Operations
#
# This is a reference workflow that demonstrates how to properly configure
# GitHub Actions authentication when your workflow needs to push changes
# back to the repository.
#
# ⚠️ This file is for reference only and is not executed.
# Copy and adapt the relevant sections as needed for your workflows.

name: Example - Automated Repository Updates

on:
  # Trigger manually from the Actions tab
  workflow_dispatch:
  
  # Trigger on a schedule (example: weekly on Sunday at midnight UTC)
  # schedule:
  #   - cron: '0 0 * * 0'

# IMPORTANT: Grant write permissions to allow pushing changes
permissions:
  contents: write  # Required for git push operations
  
# Concurrency control to prevent multiple runs
concurrency:
  group: automated-updates
  cancel-in-progress: false

jobs:
  update-and-push:
    runs-on: ubuntu-latest
    
    steps:
      # Step 1: Checkout with persisted credentials
      # This is the key step for authentication
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          # IMPORTANT: persist-credentials must be true (or omitted, as true is default)
          # This configures git to use GITHUB_TOKEN for authentication
          persist-credentials: true
          
          # Optional: Fetch full history if needed for git operations
          # fetch-depth: 0
      
      # Step 2: Set up Node.js (if needed for your tasks)
      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      
      # Step 3: Install dependencies (if needed)
      - name: Install dependencies
        run: npm ci
      
      # Step 4: Perform your automated tasks
      # This is where you run scripts, generate files, update documentation, etc.
      - name: Run automated tasks
        run: |
          # Example: Update a timestamp file
          echo "Last updated: $(date -u)" > .github/last-updated.txt
          
          # Example: Run a script that modifies files
          # npm run generate-docs
          
          # Example: Format code
          # npm run format
      
      # Step 5: Configure git identity for commits
      # Use the GitHub Actions bot identity
      - name: Configure Git
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
      
      # Step 6: Commit and push changes
      # This step handles the actual git operations
      - name: Commit and push changes
        run: |
          # Check if there are any changes
          if [[ -n $(git status --porcelain) ]]; then
            echo "Changes detected, committing..."
            
            # Stage all changes
            git add .
            
            # Commit with a descriptive message
            git commit -m "chore: automated update [skip ci]" \
                      -m "Generated by workflow: ${{ github.workflow }}" \
                      -m "Run ID: ${{ github.run_id }}"
            
            # Push to the same branch that triggered the workflow
            git push origin HEAD:${{ github.ref_name }}
            
            echo "✅ Changes pushed successfully"
          else
            echo "ℹ️ No changes to commit"
          fi
      
      # Optional: Create a summary
      - name: Job summary
        if: success()
        run: |
          echo "## 🎉 Update Complete" >> $GITHUB_STEP_SUMMARY
          echo "" >> $GITHUB_STEP_SUMMARY
          echo "The automated update workflow completed successfully." >> $GITHUB_STEP_SUMMARY
          echo "- Workflow: ${{ github.workflow }}" >> $GITHUB_STEP_SUMMARY
          echo "- Branch: ${{ github.ref_name }}" >> $GITHUB_STEP_SUMMARY
          echo "- Commit: $(git rev-parse HEAD)" >> $GITHUB_STEP_SUMMARY

# Alternative Approach: Using a different authentication method
# If you need to push to protected branches or modify workflow files,
# you may need to use a Personal Access Token (PAT) instead of GITHUB_TOKEN

jobs-with-pat:
  update-with-pat:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout with PAT
        uses: actions/checkout@v4
        with:
          # Use a PAT stored in repository secrets
          token: ${{ secrets.PAT_TOKEN }}
          persist-credentials: true
      
      # Rest of the steps remain the same...
      # The PAT provides additional permissions compared to GITHUB_TOKEN

# Notes:
# - [skip ci] in commit message prevents triggering workflows on the automated commit
# - Always check for changes before attempting to commit/push
# - Use meaningful commit messages with context
# - Consider using branch protection rules appropriately
# - Test thoroughly before deploying to production workflows
