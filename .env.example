# Database Configuration
DATABASE_URL="file:prisma/dev.db"

# ============================================================================
# SOCIAL MEDIA API CREDENTIALS
# ============================================================================

# YouTube Data API v3
# Get your key from: https://console.cloud.google.com/
# 1. Create a project
# 2. Enable "YouTube Data API v3"
# 3. Create credentials > API Key
# Cost: FREE (10,000 units/day)
# SECURITY WARNING: This key will be visible in browser JavaScript on GitHub Pages
# Recommended: Add HTTP restrictions in Google Cloud Console
NEXT_PUBLIC_YOUTUBE_API_KEY=""

# X (Twitter) API v2
# Get credentials from: https://developer.twitter.com/
# NOTE: X API is now PAID ONLY - Basic plan starts at $100/month
# Free tier was discontinued in 2023
X_BEARER_TOKEN=""
X_API_KEY=""
X_API_SECRET=""
# Legacy env var names (still supported)
TWITTER_BEARER_TOKEN=""
TWITTER_API_KEY=""
TWITTER_API_SECRET=""

# Bluesky (AT Protocol)
# NO API KEY REQUIRED for public read access!
# Just use the public API: https://public.api.bsky.app
# For authenticated actions (posting, following), you would need:
# BLUESKY_HANDLE=""
# BLUESKY_APP_PASSWORD=""

# Reddit API
# Get credentials from: https://www.reddit.com/prefs/apps
# NO API KEY REQUIRED for basic read-only access!
# For higher rate limits, create an app and use OAuth
REDDIT_USER_AGENT="something-s-happening/0.1"
# Optional (for authenticated access):
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""

# ============================================================================
# OPTIONAL APIS
# ============================================================================

# Unsplash API (for stock photos)
# Get from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=""

