# Database Configuration
DATABASE_URL="file:prisma/dev.db"

# ============================================================================
# SOCIAL MEDIA API CREDENTIALS
# ============================================================================

# YouTube Data API v3
# Get your key from: https://console.cloud.google.com/
# 1. Create a project
# 2. Enable "YouTube Data API v3"
# 3. Create credentials > API Key
# Cost: FREE (10,000 units/day)
# IMPORTANT: This is SERVER-SIDE ONLY (not exposed to browser)
# Use YOUTUBE_API_KEY for server-side scripts and API calls
YOUTUBE_API_KEY=""

# Bluesky (AT Protocol)
# NO API KEY REQUIRED for public read access!
# Just use the public API: https://public.api.bsky.app
# For authenticated actions (posting, following), you would need:
# BLUESKY_HANDLE=""
# BLUESKY_APP_PASSWORD=""

# Reddit API
# Get credentials from: https://www.reddit.com/prefs/apps
# NO API KEY REQUIRED for basic read-only access!
# For higher rate limits, create an app and use OAuth
REDDIT_USER_AGENT="something-s-happening/0.1"
# Optional (for authenticated access):
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""

# ============================================================================
# OPTIONAL APIS
# ============================================================================

# Unsplash API (for stock photos)
# Get from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=""

